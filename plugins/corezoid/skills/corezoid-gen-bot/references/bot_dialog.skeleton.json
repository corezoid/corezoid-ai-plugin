       "err_node_id": "bb0000000000000000000022",
       "lang": "js",
       "src": "// An api_rpc callee's res_data merges into THIS task at top level, so the\n// domain process's envelope arrives as data.result / data.code plus its\n// payload keys. ES5 only: no let/const, arrows or template literals.\n// NOTE: Corezoid does not interpolate {{...}} inside a Code node's src — every\n// {{UPPER_CASE}} below is substituted by the generator, not at runtime.\nvar result = String(data.result || \"\");\nvar code = String(data.code || \"\");\n\nif (result === \"success\" || code === \"200\") {\n    data.outcome = \"success\";\n    data.text_id = \"{{SUCCESS_TEXT_ID}}\";\n} else if (result === \"error\") {\n    data.outcome = \"error\";\n    data.text_id = \"serviceError\";\n} else if (result === \"\") {\n    // The callee replied with no envelope at all. Reporting this as success\n    // would render an empty message; a user reads that as a broken bot.\n    data.outcome = \"error\";\n    data.text_id = \"serviceError\";\n} else {\n    // A non-error, non-success verdict (registration, recovery, ...) is a\n    // control-flow outcome, not a failure — give it its own copy.\n    data.outcome = \"alternate\";\n    data.text_id = \"{{ALTERNATE_TEXT_ID}}\";\n}\n\n// Clear the shared envelope: a second domain call in this task would\n// otherwise be read as this one's verdict.\ndata.result = \"\";\ndata.code = \"\";\n",
