{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://corezoid.com/schemas/project-policy.json",
  "title": "Corezoid project safety policy",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "cycle_safety": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["off", "warn", "strict"]
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 1
        },
        "max_duration_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "require_retry_delay": {
          "type": "boolean"
        }
      }
    },
    "process_contracts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["off", "warn", "strict"]
        },
        "dependency_scope": {
          "type": "string",
          "enum": ["self", "project"]
        }
      }
    }
  }
}
